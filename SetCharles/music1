//KICK

const hihat = s("hh")
  .struct("X - X - X - X X X")
  .slow(1)
  .gain(0.2)
  .hpf(15000)

const kick = s("bd ~ bd bd")
  //.struct(" X - X X")
  .lpf(300)

const snare = s("cp")
  .struct(" X - - -")
  .gain(0.7)
  .lpf(600)
  



// $: hihat
// $: kick
// $: snare




const bass = s("sin")
  .note("c1")
  .struct(" X - ")
  .fast(4)
  .dist(3)
  .gain(3)
  .lpf(200)

const kickbass = s("bd")
  .struct(" X - X - X - X - X - X - X - X X")
  .dist(2)
  .slow(4)
  .gain(2)
  .lpf(300)

const snarebass = s("ht")
  .struct(" - X ")
  .gain(1)

const hihatbass = s("hh")
  .struct(" X - X - X - X - X - X - X - X -")
  .slow(4)
  .gain(0.9)
  .hpf(15000)

const melodrop = s("sin")
  .note("d4 ~ a4 ~ f4 ~ e4 ~")
  .slow(4)

$: bass
$: kickbass
$: snarebass
$: hihatbass
$: melodrop
