setcpm(90)


//MELODIE

const pianoMelo = note("d4 ~ a4 ~ f4 ~ e4 ~")
    .s("piano")
    .gain(0.8)
    .room(0.4)
    .lpf(500)

const high = note("d6 ~ a6 ~ f6 ~ e6 ~")
  .s("piano")
  .slow(8)
  .gain(0.35)
  .room(0.6)
  .lpf(1800)

const violon = note("[d4 a4 f4 e4]")
    .s("gm_violin")
    .slow(16)
    .gain(0.5)
    .room(0.4)
    .lpf(1000)



// $: pianoMelo
// $: high
// $: violon

